{
  "schemaVersion": 1,
  "basePath": "/api",
  "source": {
    "controller": "src/main/java/com/spt/learningmanage/controller/RagController.java",
    "mapping": "@PostMapping(value = \"/ask/stream\", produces = MediaType.TEXT_EVENT_STREAM_VALUE)",
    "method": "askStream"
  },
  "paths": {
    "/ai/rag/ask/stream": {
      "post": {
        "tags": ["AI RAG"],
        "summary": "以安全阶段事件流返回权限感知的项目知识回答",
        "operationId": "askStream",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RagAskRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "请求参数或 Schema 错误" },
          "401": { "description": "未登录或登录已失效" },
          "403": { "description": "权限不足" },
          "409": { "description": "状态冲突" },
          "429": { "description": "限流、额度或并发超限" },
          "500": { "description": "服务端操作失败" },
          "503": { "description": "依赖或功能暂不可用" }
        },
        "x-learning-manage-stream-contract": {
          "accept": "text/event-stream",
          "requestFields": {
            "question": { "type": "string", "required": true, "maxLength": 1000 },
            "projectId": { "type": "integer", "format": "int64", "required": true, "minimum": 1 }
          },
          "responseHeaders": {
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no"
          },
          "events": ["accepted", "stage", "complete", "error"],
          "stageValues": ["RETRIEVING", "RERANKING", "GENERATING", "VERIFYING"],
          "rawTokenDelta": false,
          "partialPersistence": false
        }
      }
    }
  }
}